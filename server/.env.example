# Server configuration
PORT=4000

# Comma separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# Persistence layer: "memory" (default) or "mongo"
# "mongo" is intentionally NOT wired up for this assessment - see README.
PERSISTENCE=memory

# MongoDB connection string (placeholder only - never commit real credentials)
MONGODB_URI=mongodb://localhost:27017/appointment_manager
